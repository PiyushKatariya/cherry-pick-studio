{
  "name": "cherry-pick-studio",
  "version": "1.0.0",
  "description": "Browser + desktop UI for automating git cherry-picks into client branches. Shares one core git engine and one frontend across an Express web server and an Electron desktop app.",
  "main": "desktop-electron/main.js",
  "scripts": {
    "start": "node server/server.js",
    "web": "node server/server.js",
    "desktop": "electron .",
    "test": "node core/selftest-units.js && node core/selftest.js",
    "test:units": "node core/selftest-units.js",
    "dist": "electron-builder --win --x64"
  },
  "author": "Piyush Katariya <piyushkatariya15@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.piyushkatariya.cherry-pick-studio",
    "productName": "Cherry-Pick Studio",
    "artifactName": "${productName}-${version}-win-${arch}.${ext}",
    "directories": { "output": "dist" },
    "files": [
      "core/**/*",
      "frontend/**/*",
      "server/**/*",
      "desktop-electron/**/*",
      "docs/**/*",
      "package.json",
      "!core/selftest*.js"
    ],
    "asarUnpack": [
      "frontend/**/*",
      "docs/**/*"
    ],
    "extraFiles": [
      { "from": "launchers", "to": ".", "filter": ["**/*"] }
    ],
    "npmRebuild": false,
    "win": {
      "target": [{ "target": "zip", "arch": ["x64"] }]
    }
  }
}
